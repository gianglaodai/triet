// EXPECT: 5
// WO-MethodCallFatReturn (ADR-0065 §14.7 AMEND, 2026-07-25): closed by
// mirroring copy #2's (`Expr::Call`) `is_fat_ret`/`is_enum_ret` unwrap into
// copy #3 (`Expr::MethodCall`, `triet-lower/src/lib.rs:5501`). A trait
// method returning `Enum?` (Nullable, unit-only payload) now dispatches
// through sret (`EnumAlloc` disc-niche + `ReturnShape::Enum`) instead of
// falling through to the trailing refuse. Was fixture 453 "_refused"
// (proved the pre-fix copy failed CLOSED, not open into a miscompile);
// flipped now that the copy is closed.
enum U { A, B }

trait Maker {
    function make(self) -> U?
}

implement Maker for Integer {
    function make(self) -> U? { return ~+ U::A }
}

function main() -> Integer {
    let x = (10).make();
    return match x {
        ~+ v => match v { U::A => 5, U::B => 9 },
        ~0 => -1,
    };
}
