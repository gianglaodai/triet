// ERROR: E1058
// WO-Reference-Operand-Eq-Refuse: `&0 P == &0 P` where both operands are
// independently allocated `let`s with the SAME field content. Pre-fix
// (measured on `d8fa041`): `Statement::Borrow` yields the slot ADDRESS for
// a struct local — generic `icmp` compares the two distinct StackSlot
// addresses, which never match, so `s == t` silently returned 0 (exit 0,
// no diagnostic) even though the struct's owned form is already refused.
// Must now refuse at typecheck instead of silently computing the wrong
// answer through the reference.
struct P { x: Integer, y: Integer }

function f(s: &0 P, t: &0 P) -> Integer {
    if s == t {
        return 1;
    }
    return 0;
}

function main() -> Integer {
    let a = P { x: 1, y: 2 };
    let b = P { x: 1, y: 2 };
    return f(&0 a, &0 b);
}
