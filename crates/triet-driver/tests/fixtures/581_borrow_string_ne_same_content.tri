// EXPECT: 0
// WO-Borrowed-String-Eq §C3 #3: operator variant (HP.3 — a guard proven only
// on `==` may still miss `!=`). Two `&0 String` operands with the SAME
// content through `!=` must be FALSE (content-equal, so not-equal is false).
function f(s: &0 String, t: &0 String) -> Integer {
    if s != t {
        return 1;
    }
    return 0;
}

function main() -> Integer {
    let a = "hi";
    let b = "hi";
    return f(&0 a, &0 b);
}
