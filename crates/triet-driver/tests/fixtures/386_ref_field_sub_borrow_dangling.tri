// ERROR: E2450
// ADR-0084 Slice 1b — E2450 SOLE-GUARD user-visible (thay máu bản cũ vacuous).
//
// Param `dummy: &0 String` cho typecheck TIE return-borrow vào input → NÉ E2400
// (BorrowLifetimeInferenceFailed). Bản 386 CŨ (không param) nổ E2400 typecheck-
// fatal, CLI dừng trước borrowck ⇒ user KHÔNG BAO GIỜ thấy E2450; E2450 chỉ hiện
// qua harness gộp-đa-pha = răng VACUOUS. Cọc-giả phơi E2450 thành chốt chặn THẬT.
//
// Nay pipeline chạy tới borrowck: `(&0 h).name` sub-borrow local `h`; `Drop(h)` ở
// biên hàm khi sub-borrow còn sống + được `return` ⇒ E2450 (CLI thật, exit 3).
//
// Poison: gỡ reborrow-chase trong borrowck `Statement::Borrow` (checker.rs) — plain
// strip về `Place::local(source.local)`, không chase qua loan keyed `dest==source.local`
// ⇒ loan anchor lên `tmp` thay vì `h`, `Drop(h)` không thấy loan ⇒ E2450 BIẾN MẤT,
// compile SẠCH, dangling `&0 String` return xuống JIT = UAF thật (khác 386 cũ: E2400
// không còn che). Chase là SOLE-GUARD trên đường tới-runtime.
struct Holder {
    name: String,
}

function bad(dummy: &0 String) -> &0 String {
    let h = Holder { name: "x" };
    return (&0 h).name;
}

function main() -> Integer {
    let junk = "y";
    let result = bad(&0 junk);
    return 0;
}
