// ERROR: E1054
// WO-HashMap-Drain-PA2 (ADR-0089 §AMEND-2 §4): `V = Integer?` (nullable
// value) stays refused for `.drain()` — same nested-nullable/aggregate-
// move-out family of concerns ADR-0088 already refuses elsewhere (E1055),
// kept consistent here under the SAME E1054 drain-shape code rather than a
// second code for the same "unsupported HashMap-drain shape" contract.
function main() -> Integer {
    let mutable m: HashMap<Integer, Integer?> = hashmap_new();
    m = insert(m, 1, 10);
    let mutable total = 0;
    for (k, v) in m.drain() {
        total = total + 1;
    }
    return total;
}
