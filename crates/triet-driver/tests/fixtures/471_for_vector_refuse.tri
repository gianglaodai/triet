// ERROR: E1052
// ADR-0089 §2: iteration over a non-Range iterable (here: Vector<Integer>)
// must be refused at typecheck (E1052), NOT fall through silently to
// Type::Unknown and crash later in the lowerer (E1100).
function main() -> Integer {
    let mutable xs = vector_new();
    xs = push(xs, 10);
    xs = push(xs, 20);
    let mutable sum = 0;
    for x in xs {
        sum = sum + x;
    }
    return sum;
}
