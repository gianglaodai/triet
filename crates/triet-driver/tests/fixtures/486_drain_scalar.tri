// EXPECT: 60
// ADR-0089 §AMEND Slice 2b — T2b-scalar: `for x in v.drain()` on
// `Vector<Integer>` sums the elements via MOVE-OUT (the pop_front-loop
// desugar, §2b.4). `v` is fully consumed by the loop; only the (now
// empty) buffer remains to be dropped at scope exit.
function main() -> Integer {
    let mutable xs = vector_new();
    xs = push(xs, 10);
    xs = push(xs, 20);
    xs = push(xs, 30);
    let mutable sum = 0;
    for x in xs.drain() {
        sum = sum + x;
    }
    return sum;
}
