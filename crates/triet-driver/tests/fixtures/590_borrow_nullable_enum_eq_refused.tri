// ERROR: E1058
// WO-Reference-Operand-Eq-Refuse: `&0 Color? == &0 Color?`, a
// `Nullable(payload-free enum)` through a reference, same variant. Pre-fix
// (measured on `d8fa041`): `Statement::Borrow` yields the slot ADDRESS for
// the `Color?` local — generic `icmp` on that address always returns 0 for
// two distinct allocations, silently wrong (exit 0, no diagnostic). This is
// the orthogonal twin of fixture 589: without a DEDICATED
// `Nullable(UserEnum)` arm in `is_eq_refused`'s `Self::Reference` match,
// falling through to `other.is_eq_refused()` on `Nullable(Color)` returns
// false (payload-free enum is not refused when owned), reopening the hole
// one level down even after 589 is patched.
enum Color { Red, Green }

function f(s: &0 Color?, t: &0 Color?) -> Integer {
    if s == t {
        return 1;
    }
    return 0;
}

function main() -> Integer {
    let a: Color? = Color::Red;
    let b: Color? = Color::Red;
    return f(&0 a, &0 b);
}
