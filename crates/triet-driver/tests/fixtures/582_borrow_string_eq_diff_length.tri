// EXPECT: 0
// WO-Borrowed-String-Eq §C3 #4. The originally scoped shape ("mixed &+/&0
// reference form on the SAME `==`") is NOT buildable: typecheck treats
// `&0 String` and `&+ String` as DISTINCT types, so `s == t` across the two
// forms is refused at the type level, before lower/JIT ever run —
//   triet::typecheck::E1004 "invalid operands for `==`: expected two
//   operands of the same type, found `&0 String` and `&+ String`"
// (measured on a throwaway probe, not committed as a fixture — this is a
// design-level refusal unrelated to this WO's JIT dispatch fix, so it is
// out of scope to chase further here).
//
// Per the appendix's fallback, this fixture instead covers `&0 String`
// operands of DIFFERENT LENGTH ("hi" vs "hii") — the borrow-side analogue of
// fixture 570 (owned-String prefix-length case) — catching a shim/dispatch
// that reads a fixed byte count or only compares a length prefix through
// the reference-read path.
//
// §C2.3 (repr independent of reference FORM) is instead confirmed directly:
// ad-hoc probes with BOTH operands bound via `&+` (`&+ String == &+ String`)
// and BOTH via `&- ` (`&- String == &- String`) on same-content strings each
// independently returned `1` — the dispatch added in this WO matches only on
// `MirType::Reference { inner: String, .. }` and never inspects `form`, so
// every form takes the identical `use_var` + `load(ptr@0)/(len@8)` path.
function f(s: &0 String, t: &0 String) -> Integer {
    if s == t {
        return 1;
    }
    return 0;
}

function main() -> Integer {
    let a = "hi";
    let b = "hii";
    return f(&0 a, &0 b);
}
