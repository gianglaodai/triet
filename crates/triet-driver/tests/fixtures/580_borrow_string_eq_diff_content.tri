// EXPECT: 0
// WO-Borrowed-String-Eq §C3 #2: two `&0 String` operands with DIFFERENT
// content but the SAME length ("hi" vs "xx") — pairs with 579 (same
// content) to catch a shim/dispatch that only compares `len`, ignoring the
// bytes, through the reference-read path.
function f(s: &0 String, t: &0 String) -> Integer {
    if s == t {
        return 1;
    }
    return 0;
}

function main() -> Integer {
    let a = "hi";
    let b = "xx";
    return f(&0 a, &0 b);
}
