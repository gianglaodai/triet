// ERROR: E1058
// WO-Reference-Operand-Eq-Refuse: `&0 Vector<Integer> == &0 Vector<Integer>`,
// two independently allocated vectors with the SAME content. Pre-fix
// (measured on `d8fa041`): `Statement::Borrow` yields the slot ADDRESS for
// the Vector local — generic `icmp` on that address always returns 0 for
// two distinct allocations, silently wrong (exit 0, no diagnostic), even
// though the owned `Vector == Vector` form is already refused. Must refuse
// through the reference too.
function f(s: &0 Vector<Integer>, t: &0 Vector<Integer>) -> Integer {
    if s == t {
        return 1;
    }
    return 0;
}

function main() -> Integer {
    let mutable a = vector_new();
    a = push(a, 1);
    let mutable b = vector_new();
    b = push(b, 1);
    return f(&0 a, &0 b);
}
