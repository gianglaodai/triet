// EXPECT: 1
// WO-Borrowed-String-Eq §C0: two `&0 String` params bound to independently
// allocated `let`s with the SAME content. Pre-fix, `MirType::Reference {
// inner: String, .. }` missed the dispatch at `mir_lower.rs:3511-3517` (only
// bare `MirType::String` matched) and fell through to `lower_binop`'s raw
// `icmp` on the reference VALUE (the owner's StackSlot address) — two
// distinct allocations of "hi" never share that address, so `s == t`
// silently returned FALSE (exit 0, no crash, no diagnostic). Content-compare
// through the reference must return TRUE.
function f(s: &0 String, t: &0 String) -> Integer {
    if s == t {
        return 1;
    }
    return 0;
}

function main() -> Integer {
    let a = "hi";
    let b = "hi";
    return f(&0 a, &0 b);
}
