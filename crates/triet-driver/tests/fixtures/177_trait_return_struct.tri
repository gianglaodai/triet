// EXPECT: 30
// Nợ #2 (ADR-0061): trait method returning a flat struct lowers via sret.
// `self` flows into the struct so both dispatch and sret are load-bearing:
// (10).make() → Point { x: 10, y: 20 } → 10 + 20 = 30.
//
// Block body (`{ return ... }`) is used here. The expression-body form
// (`= Point { ... }`) once hit a tail-expr fat-struct-return SIGILL, but that
// debt is now CLOSED (O triage 2026-07-25: `make() -> Point = Point{...}` on a
// plain free fn returns 30, exit 0). The old "separate debt" note is retired;
// this fixture isolates the nợ #2 trait-dispatch path.
struct Point { x: Integer, y: Integer }

trait Maker {
    function make(self) -> Point
}

implement Maker for Integer {
    function make(self) -> Point { return Point { x: self, y: 20 } }
}

function main() -> Integer = {
    let p = (10).make();
    return p.x + p.y;
}
